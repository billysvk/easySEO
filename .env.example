# easySEO configuration. Copy to `.env` and fill in values.

# --- Provider selection ---
# "gemini" (remote, multimodal) or "ollama" (local).
AI_PROVIDER=gemini

# --- Gemini (remote) ---
GEMINI_API_KEY=
# Optional: upgrade to a stronger model for higher-quality output.
# Examples: gemini-2.0-flash (default, fast/cheap), gemini-2.5-pro (expert).
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
# Use a vision model (e.g. llava, gemma3) if you want screenshot analysis.
OLLAMA_MODEL=llama3.2:latest
# Context window. Raise this for long transcripts so the prompt isn't truncated.
OLLAMA_NUM_CTX=16384

# --- Generation tuning (both providers) ---
LLM_TEMPERATURE=0.7

# --- Market intelligence ---
# Country code for Google Trends "trending now" sweeps (viewer market).
TREND_GEO=GR
# Seconds before giving up on a local generation (CPU runs are slow).
OLLAMA_TIMEOUT=1800
